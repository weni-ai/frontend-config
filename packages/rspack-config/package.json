{
  "name": "@weni/rspack-config",
  "version": "0.0.0",
  "description": "Shared Rspack preset for Weni microfrontends",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weni-ai/frontend-config.git",
    "directory": "packages/rspack-config"
  },
  "homepage": "https://github.com/weni-ai/frontend-config/tree/main/packages/rspack-config",
  "bugs": {
    "url": "https://github.com/weni-ai/frontend-config/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hmr": {
      "types": "./dist/hmr.d.ts",
      "import": "./dist/hmr.js"
    },
    "./types": "./dist/types/webpackHot.d.ts"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node ./scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "html-rspack-plugin": "^6.0.2"
  },
  "peerDependencies": {
    "@rspack/cli": "^1.1.5",
    "@rspack/core": "^1.1.5",
    "css-loader": "^7.1.0",
    "pinia": ">=2",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "postcss-prefixwrap": "^1.58.0",
    "sass-loader": ">=13",
    "vue": "^3.0.0",
    "vue-loader": "^17.4.0",
    "vue-style-loader": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "postcss": { "optional": true },
    "postcss-loader": { "optional": true },
    "postcss-prefixwrap": { "optional": true }
  },
  "devDependencies": {
    "@rspack/cli": "^1.1.5",
    "@rspack/core": "^1.1.5",
    "pinia": "^3.0.2",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "postcss-prefixwrap": "^1.58.0",
    "vue": "3.5.11",
    "vue-loader": "^17.4.2"
  }
}
